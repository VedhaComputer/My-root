# ==============================================================================
# My Root Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
# Set TRUST_PROXY to 'loopback', 'linklocal', 'uniquelocal', '1' (or specific IP/CIDR) behind reverse proxies (Nginx/Cloudflare/ALB)
TRUST_PROXY=false

# MongoDB Database URI (Must support replica set for multi-document ACID transactions)
MONGODB_URI=mongodb://localhost:27017/myroot

# JWT Authentication (RS256 primary, HS256 development fallback)
JWT_ISSUER=myroot-backend
JWT_AUDIENCE=myroot-platform
# Set to 'true' only in development/test environments if RS256 keypair is not generated
JWT_ALLOW_HS256_FALLBACK=false

# RS256 Keys: Provide PEM file paths OR direct PEM string variables
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# HS256 HMAC Secrets (Fallback only; minimum 32 characters, recommended 64+)
JWT_ACCESS_SECRET=replace_with_secure_random_access_secret_min_64_chars_long
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_min_64_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Strict Auth Rate Limiting (Login & Registration endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Email Delivery Configuration
EMAIL_FROM=noreply@myroot.in
FRONTEND_URL=http://localhost:3000
# In production, MAIL_TRANSPORT must be 'smtp' (console/test prohibited)
MAIL_TRANSPORT=test
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE: 'true' for port 465 (SMTPS direct SSL/TLS); 'false' for port 587 (STARTTLS).
# If omitted, defaults to 'true' for port 465, and 'false' otherwise.
SMTP_SECURE=false
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
# SMTP Connection and Greeting Timeout in milliseconds (default: 10000)
SMTP_TIMEOUT_MS=10000

# India Place API Gateway Configuration
PLACE_API_PROXY_ENABLED=true
PLACE_API_BASE_URL=http://localhost:4001
# Gateway Authentication Secret: Must be at least 32 characters and NEVER placeholder in production
PLACE_API_APP_GATE_SECRET=replace_with_secure_random_secret_min_32_chars_for_apps
PLACE_API_APP_TOKEN=replace_with_optional_bearer_app_token
PLACE_API_TIMEOUT_MS=5000
