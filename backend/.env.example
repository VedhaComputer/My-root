# ==============================================================================
# My Root Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
# Set TRUST_PROXY to 'loopback', 'linklocal', 'uniquelocal', '1' (or specific IP/CIDR) behind reverse proxies (Nginx/Cloudflare/ALB)
TRUST_PROXY=false

# MongoDB Database URI (Must support replica set for multi-document ACID transactions)
MONGODB_URI=mongodb://localhost:27017/myroot
# MONGODB_DATABASE: Optional explicit database name override (defaults to URI path or 'myroot')
# MONGODB_DATABASE=myroot

# JWT Authentication (RS256 primary, HS256 development fallback)
JWT_ISSUER=myroot-backend
JWT_AUDIENCE=myroot-platform
# Set to 'true' only in development/test environments if RS256 keypair is not generated
JWT_ALLOW_HS256_FALLBACK=false

# RS256 Keys: Provide PEM file paths (relative to project/backend root or absolute) OR direct PEM string variables
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# HS256 HMAC Secrets (Fallback only; minimum 32 characters, recommended 64+)
JWT_ACCESS_SECRET=replace_with_secure_random_access_secret_min_64_chars_long
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_min_64_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Strict Auth Rate Limiting (Login, Registration, Password Reset)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Account-Specific Rate Limiting (Targeted Brute-Force Defense)
AUTH_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
AUTH_ACCOUNT_RATE_LIMIT_MAX=20

# Rate Limit Storage (Optional: 'redis' for multi-instance cluster, 'memory' for single instance)
# RATE_LIMIT_STORE=redis
# REDIS_URL=redis://127.0.0.1:6379

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000

# Email Delivery Configuration
# EMAIL_FROM: Strict RFC 5322 format (e.g., noreply@myroot.in or "My Root <noreply@myroot.in>")
EMAIL_FROM=noreply@myroot.in
FRONTEND_URL=http://localhost:3000

# MAIL_TRANSPORT:
# In development: 'console' (prints verification link and token to server terminal) or 'smtp' (delivers via SMTP server).
# In production: strictly 'smtp' (console/test are prohibited).
MAIL_TRANSPORT=console

# SMTP Settings (Required when MAIL_TRANSPORT=smtp, mandatory in production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_username
# SMTP_PASS=smtp_password
# SMTP_TIMEOUT_MS=10000

# India Place API Gateway (Optional proxy integration)
PLACE_API_PROXY_ENABLED=true
PLACE_API_BASE_URL=http://localhost:4001
PLACE_API_APP_GATE_SECRET=replace_with_secure_random_secret_min_32_chars_for_apps
# PLACE_API_APP_TOKEN=optional_static_bearer_override
# Timeout for Place API gateway requests (ms). Substring regex over 630K docs can take
# ~6 s for large result sets requiring countDocuments. Set to at least 15000 in production.
PLACE_API_TIMEOUT_MS=15000
